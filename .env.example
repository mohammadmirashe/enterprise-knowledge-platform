APP_NAME=Enterprise Knowledge Platform
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=700
CHUNK_OVERLAP=150
RETRIEVER_FETCH_K=12
RETRIEVER_FINAL_K=5
RETRIEVER_MIN_SCORE=0.30
DEMO_MODE=false
UPLOADS_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTOR_DIR=storage/vector_db
SQLITE_PATH=storage/knowledge.db
